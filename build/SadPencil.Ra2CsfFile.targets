<Project>

  <!-- The bundled ini parser and the upstream one define the same types, so reference one of them. -->
  <Target Name="WarnAboutUpstreamIniParser" AfterTargets="ResolveAssemblyReferences" BeforeTargets="Build">
    <ItemGroup>
      <_UpstreamIniParserAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'INIFileParser'" />
      <_UpstreamIniParserPackage Include="@(PackageReference)"
                                 Condition="'%(Identity)' == 'ini-parser' Or '%(Identity)' == 'ini-parser-netstandard'" />
    </ItemGroup>
    <Warning Condition="'@(_UpstreamIniParserAssembly)' != '' Or '@(_UpstreamIniParserPackage)' != ''"
             Code="SPCSF001"
             Text="The project references INIFileParser (ini-parser or ini-parser-netstandard) besides the ini parser bundled with SadPencil.Ra2CsfFile, and the two define the same types. The upstream parser also does not keep the whitespace of a label value; remove the package reference." />
  </Target>

</Project>
