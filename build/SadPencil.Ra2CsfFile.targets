<Project>

  <!-- The upstream parser can also be referenced as a plain assembly, without a package. -->
  <Target Name="WarnAboutUpstreamIniParser" AfterTargets="ResolveAssemblyReferences" BeforeTargets="Build">
    <ItemGroup>
      <_UpstreamIniParserAssembly Include="@(ReferencePath)" Condition="'%(Filename)' == 'INIFileParser'" />
      <_UpstreamIniParserPackage Include="@(PackageReference)"
                                 Condition="'%(Identity)' == 'ini-parser' Or '%(Identity)' == 'ini-parser-netstandard'" />
    </ItemGroup>
    <Warning Condition="'@(_UpstreamIniParserAssembly)' != '' Or '@(_UpstreamIniParserPackage)' != ''"
             Code="SPCSF001"
             Text="SadPencil.Ra2CsfFile bundles its own ini parser, and this project also references the upstream INIFileParser (ini-parser or ini-parser-netstandard). Both define the IniParser types, and the upstream parser trims the whitespace of a label value; remove the upstream package reference." />
  </Target>

</Project>
