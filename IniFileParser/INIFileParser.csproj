<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>INIFileParser</AssemblyName>
    <RootNamespace>IniParser</RootNamespace>
    <Version>2.5.2</Version>
    <!-- INIFileParser.dll is included in the SadPencil.Ra2CsfFile package and has no separate package. -->
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- ini-parser 2.5.2 contains malformed XML documentation and uses obsolete members. -->
    <NoWarn>$(NoWarn);CS1591;CS0618;CS1570;CS1573;CS1574</NoWarn>
  </PropertyGroup>

</Project>
